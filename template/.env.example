# Set these as GLOBAL env vars in the Beachhead dashboard (no Target Service),
# because docker-compose.yml references them as ${VAR}.
DB_PASSWORD=
# Needed once, to create the owner account at /admin. Remove it afterwards.
ADMIN_BOOTSTRAP_TOKEN=
PUBLIC_URL=https://example.com
# Optional: store uploaded images in brew-bucket instead of the local volume.
BREW_BUCKET_URL=
BREW_BUCKET_KEY=
