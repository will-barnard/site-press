# Set as GLOBAL env vars in the Beachhead dashboard (no Target Service):
# docker-compose.yml reads them as ${VAR}, which only resolves from .env.

DB_PASSWORD=

# Optional. If set, creating the first (admin) account needs it.
BOOTSTRAP_TOKEN=

# dry-dock personal API. Pool "coder" = the MacBook's qwen2.5-coder:32b.
DRYDOCK_BASE_URL=https://drydock.example.com
DRYDOCK_API_KEY=
DRYDOCK_POOL=coder
# 1 = when the coder pool has no worker (MacBook asleep), retry that call
# unpinned instead of falling back to rules-only.
DRYDOCK_FALLBACK_UNPINNED=1

# brew-bucket: finished sites + reports go to the artifacts bucket.
# Mint a key scoped to write on "artifacts" only.
BREW_BUCKET_URL=https://bucket.example.com
BREW_BUCKET_KEY=
BREW_BUCKET_ARTIFACTS=artifacts

# Pass marks for the verify stage. Uncalibrated — tune after running against
# sites you've already rebuilt by hand.
PASS_VISUAL=0.72
PASS_TEXT=0.97

# 1 = allow rebuilding sites on private/LAN addresses.
ALLOW_PRIVATE_URLS=0
